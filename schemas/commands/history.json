{
  "family": "history",
  "description": "Backend undo / redo of the active library entry (SSOT I3).",
  "commands": [
    {
      "name": "history.undo",
      "title": "Undo",
      "description": "Reverts the latest edit group of the active entry, or the latest group touching `domains` (e.g. feedback@output).",
      "target": "backend",
      "tier": "write",
      "long_running": false,
      "doc": "modules/pianoid-middleware/REST_API.md#undo--redo-ssot-i3",
      "route": {"method": "POST", "path": "/history/undo"},
      "args": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domains": {"type": "array", "items": {"type": "string"}, "description": "Optional domain filter"}
        }
      },
      "result": {"type": "object"}
    },
    {
      "name": "history.redo",
      "title": "Redo",
      "description": "Re-applies the latest undone group (same domain filter as history.undo).",
      "target": "backend",
      "tier": "write",
      "long_running": false,
      "doc": "modules/pianoid-middleware/REST_API.md#undo--redo-ssot-i3",
      "route": {"method": "POST", "path": "/history/redo"},
      "args": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domains": {"type": "array", "items": {"type": "string"}, "description": "Optional domain filter"}
        }
      },
      "result": {"type": "object"}
    },
    {
      "name": "history.get",
      "title": "Undo / redo state",
      "description": "{entry, can_undo, can_redo, undo, redo, undo_domains, redo_domains, depth}.",
      "target": "backend",
      "tier": "read",
      "long_running": false,
      "doc": "modules/pianoid-middleware/REST_API.md#undo--redo-ssot-i3",
      "route": {"method": "GET", "path": "/history"},
      "args": {"type": "object", "additionalProperties": false, "properties": {}},
      "result": {"type": "object"}
    }
  ]
}
