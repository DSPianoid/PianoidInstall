modal_projects/

# Build output / generated
site/
# Python venv + caches
.venv/
__pycache__/
*.pyc
# IDE
.idea/
# Nested independent clones (worked on in their own windows; not tracked by the outer repo)
/PianoidCore/
/PianoidTunner/
/PianoidBasic/

# Local clone of the user-level config repo (DSPianoid/claude-config); not part of this repo
claude-config/

# Measurement data (default <PianoidInstall>/measurements) and the local runtime settings (measurements folder)
/measurements/
/pianoid_local_settings.json
/pianoid_local_settings.json.tmp

# MIDI files for the MIDI Player (default <PianoidInstall>/MidiRecords): contents local, README tracked
/MidiRecords/*
!/MidiRecords/README.md

# The user's parameter-rule overrides (dev-psafe2, param_rules.RuleTable; $PIANOID_PARAM_RULES overrides the path)
/param_rules_overrides.json
/param_rules_overrides.json.tmp
